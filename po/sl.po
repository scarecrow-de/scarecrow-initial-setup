msgstr "Prijava v domeno je spodletela"

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:17
msgid "Enterprise Login"
msgstr "Poslovna prijava"

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:18
msgid ""
"Enterprise login allows an existing centrally managed user account to be "
"used on this device. You can also use this account to access company "
"resources on the internet."
msgstr ""
"Poslovna prijava omogoča prijavo na to napravo z obstoječim poslovnim "
"uporabniškim računom. Ta račun je mogoče uporabiti tudi za dostop do "
"poslovnih virov na internetu."

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:36
#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:287
msgid "_Domain"
msgstr "_Domena"

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:53
#: scarecrow-initial-setup/pages/account/gis-account-page-local.ui:84
msgid "_Username"
msgstr "_Uporabniško ime"

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:70
#: scarecrow-initial-setup/pages/password/gis-password-page.ui:34
msgid "_Password"
msgstr "_Geslo"

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:146
msgid "Enterprise domain or realm name"
msgstr "Poslovna domena ali ime območja"

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:211
msgid "C_ontinue"
msgstr "_Nadaljuj"

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:246
msgid "Domain Administrator Login"
msgstr "Prijava domenskega skrbnika"

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:266
msgid ""
"In order to use enterprise logins, this computer needs to be enrolled in a "
"domain. Please have your network administrator type the domain password "
"here, and choose a unique computer name for your computer."
msgstr ""
"Za uporabo poslovnega računa mora biti računalnik prijavljen v domeno. "
"Skrbnik omrežja mora vpisati domensko geslo in določiti enoznačno ime "
"računalnika."

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:321
msgid "_Computer"
msgstr "_Računalnik"

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:353
msgid "Administrator _Name"
msgstr "Ime _skrbnika"

#: scarecrow-initial-setup/pages/account/gis-account-page-enterprise.ui:387
msgid "Administrator Password"
msgstr "Skrbniško geslo"

#: scarecrow-initial-setup/pages/account/gis-account-page-local.c:207
msgid "Please check the name and username. You can choose a picture too."
msgstr "Preverite ime in uporabniško ime. Izberete lahko tudi sličico profila."

#: scarecrow-initial-setup/pages/account/gis-account-page-local.c:453
msgid "We need a few details to complete setup."
msgstr "Za končanje namestitve so zahtevani še nekateri pomembni podatki."

#: scarecrow-initial-setup/pages/account/gis-account-page-local.c:559
msgid "Administrator"
msgstr "Skrbnik"

#: scarecrow-initial-setup/pages/account/gis-account-page-local.c:565
#: scarecrow-initial-setup/pages/account/gis-account-page-local.c:608
#, c-format
msgid "Failed to create user '%s': "
msgstr "Ustvarjanje uporabniškega računa »%s« je spodletelo: "

#: scarecrow-initial-setup/pages/account/gis-account-page-local.ui:21
msgid "Avatar image"
msgstr "Slika podobe"

#: scarecrow-initial-setup/pages/account/gis-account-page-local.ui:38
#: scarecrow-initial-setup/pages/account/gis-account-page.c:283
msgid "About You"
msgstr "O vas"

#: scarecrow-initial-setup/pages/account/gis-account-page-local.ui:39
msgid "Please provide a name and username. You can choose a picture too."
msgstr ""
"Navesti je treba ime in uporabniško ime. Izberete lahko tudi sličico profila."

#: scarecrow-initial-setup/pages/account/gis-account-page-local.ui:53
msgid "_Full Name"
msgstr "Polno _ime"

#: scarecrow-initial-setup/pages/account/gis-account-page-local.ui:149
msgid "Set up _parental controls for this user"
msgstr "Nastavitve _starševskega nadzora za uporabnika"

#: scarecrow-initial-setup/pages/account/gis-account-page-local.ui:156
msgid "For use by a parent or supervisor, who must set up their own password."
msgstr "Za starše ali nadzornike, ki imajo nastavljen svoje geslo."

#: scarecrow-initial-setup/pages/account/gis-account-page.ui:43
msgid "_Enterprise Login"
msgstr "_Poslovna prijava"

#: scarecrow-initial-setup/pages/account/gis-account-page.ui:53
msgid "Go online to set up Enterprise Login."
msgstr "Vzpostavi povezavo za nastavitev poslovnega računa."

#: scarecrow-initial-setup/pages/account/um-realm-manager.c:310
msgid "Cannot automatically join this type of domain"
msgstr "Ni se mogoče samodejno pridružiti tej vrsti domene"

#: scarecrow-initial-setup/pages/account/um-realm-manager.c:373
#, c-format
msgid "No such domain or realm found"
msgstr "Ni mogoče najti take domene ali takega področja"

#: scarecrow-initial-setup/pages/account/um-realm-manager.c:782
#: scarecrow-initial-setup/pages/account/um-realm-manager.c:796
#, c-format
msgid "Cannot log in as %s at the %s domain"
msgstr "Ni se mogoče prijaviti kot %s v domeno %s."

#: scarecrow-initial-setup/pages/account/um-realm-manager.c:788
msgid "Invalid password, please try again"
msgstr "Geslo je neveljavno, poskusite znova."

#: scarecrow-initial-setup/pages/account/um-realm-manager.c:801
#, c-format
msgid "Couldn’t connect to the %s domain: %s"
msgstr "Ni se mogoče povezati z domeno %s: %s"

#: scarecrow-initial-setup/pages/account/um-utils.c:248
msgid "Sorry, that user name isn’t available. Please try another."
msgstr "Uporabniško ime ni na voljo! Izberite drugo ime."

#: scarecrow-initial-setup/pages/account/um-utils.c:251
#, c-format
msgid "The username is too long."
msgstr "Uporabniško ime je predolgo."

#: scarecrow-initial-setup/pages/account/um-utils.c:254
msgid "The username cannot start with a “-”."
msgstr "Uporabniškega imena ni mogoče začeti z vezajem » - «."

#: scarecrow-initial-setup/pages/account/um-utils.c:257
msgid "That username isn’t available. Please try another."
msgstr "Uporabniško ime ni na voljo! Izberite drugo ime."

#: scarecrow-initial-setup/pages/account/um-utils.c:260
msgid ""
"The username should only consist of upper and lower case letters from a-z, "
"digits and the following characters: . - _"
msgstr ""
"Uporabniško ime je lahko sestavljeno le iz majhnih in velikih črk od a do z, "
"številk in znakov » . «, » - « ter » _ «."

#: scarecrow-initial-setup/pages/account/um-utils.c:264
msgid "This will be used to name your home folder and can’t be changed."
msgstr ""
"S tem imenom bo poimenovana osebna mapa. Izbire kasneje ni mogoče "
"spreminjati."

#: scarecrow-initial-setup/pages/goa/gis-goa-page.c:92
msgid "Add Account"
msgstr "Dodaj račun"

#: scarecrow-initial-setup/pages/goa/gis-goa-page.c:357
msgid "Online Accounts"
msgstr "Spletni računi"

#: scarecrow-initial-setup/pages/goa/gis-goa-page.ui:17
msgid "Connect Your Online Accounts"
msgstr "Povezava z spletnih računov"

#: scarecrow-initial-setup/pages/goa/gis-goa-page.ui:18
msgid ""
"Connect your accounts to easily access your email, online calendar, "
"contacts, documents and photos."
msgstr ""
"Poveži račune za enostaven dostop do elektronske pošte, koledarjev, stikov, "
"dokumentov in fotografij."

#: scarecrow-initial-setup/pages/goa/gis-goa-page.ui:48
msgid ""
"Accounts can be added and removed at any time from the Settings application."
msgstr ""
"Račune je mogoče dodati oziroma odstraniti kadarkoli med nastavitvami "
"programa."

#: scarecrow-initial-setup/pages/keyboard/cc-input-chooser.c:240
msgid "Preview"
msgstr "Predogled"

#: scarecrow-initial-setup/pages/keyboard/cc-input-chooser.c:299
#: scarecrow-initial-setup/pages/language/cc-language-chooser.c:227
msgid "More…"
msgstr "Več …"

#. Translators: a search for input methods or keyboard layouts
#. * did not yield any results
#.
#: scarecrow-initial-setup/pages/keyboard/cc-input-chooser.c:321
msgid "No inputs found"
msgstr "Ni najdenih vhodnih naprav"

#: scarecrow-initial-setup/pages/keyboard/gis-keyboard-page.c:504
#: scarecrow-initial-setup/pages/keyboard/gis-keyboard-page.ui:15
msgid "Typing"
msgstr "Tipkanje"

#: scarecrow-initial-setup/pages/keyboard/gis-keyboard-page.ui:16
msgid "Select your keyboard layout or an input method."
msgstr "Izbor razporeditve tipkovnice ali načina vnosa."

#: scarecrow-initial-setup/pages/language/cc-language-chooser.c:243
msgid "No languages found"
msgstr "Ni najdenih jezikov"

#: scarecrow-initial-setup/pages/language/gis-language-page.c:262
msgid "Welcome"
msgstr "Dobrodošli"

#. Translators: This is meant to be a warm, engaging welcome message,
#. * like greeting somebody at the door. If the exclamation mark is not
#. * suitable for this in your language you may replace it.
#.
#: scarecrow-initial-setup/pages/language/gis-welcome-widget.c:136
msgid "Welcome!"
msgstr "Dobrodošli!"

#: scarecrow-initial-setup/pages/network/gis-network-page.c:318
msgctxt "Wireless access point"
msgid "Other…"
msgstr "Drugo …"

#: scarecrow-initial-setup/pages/network/gis-network-page.c:403
msgid "Wireless networking is disabled"
msgstr "Brezžično omrežje je onemogočeno."

#: scarecrow-initial-setup/pages/network/gis-network-page.c:410
msgid "Checking for available wireless networks"
msgstr "Preveri za dostopne brezžične omrežne povezave"

#: scarecrow-initial-setup/pages/network/gis-network-page.c:805
msgid "Network"
msgstr "Omrežje"

#: scarecrow-initial-setup/pages/network/gis-network-page.ui:18
msgid "Wi-Fi"
msgstr "Wi-Fi"

#: scarecrow-initial-setup/pages/network/gis-network-page.ui:19
msgid ""
"Connecting to the internet helps you get new apps, information, and other "
"upgrades. It also helps set the time and your location automatically."
msgstr ""
"Povezovanje v internetno omrežje omogoča dostop do novih programov, "
"podrobnosti in posodobitev. Samodejno se nastavi tudi krajevni čas in "
"geolokacijski podatki."

#: scarecrow-initial-setup/pages/network/gis-network-page.ui:76
msgid "No wireless available"
msgstr "Ni razpoložljivega brezžičnega omrežja"

#: scarecrow-initial-setup/pages/network/gis-network-page.ui:91
msgid "Turn On"
msgstr "Omogoči"

#. Translators: The placeholder is the user’s full name.
#: scarecrow-initial-setup/pages/parental-controls/gis-parental-controls-page.c:102
#, c-format
msgid "Parental Controls for %s"
msgstr "Starševski nadzor za račun %s."

#: scarecrow-initial-setup/pages/parental-controls/gis-parental-controls-page.c:104
msgid "Set restrictions on what this user can run or install."
msgstr "Nastavitev omejitev zagona in nameščanja programske opreme."

#: scarecrow-initial-setup/pages/parental-controls/gis-parental-controls-page.c:199
msgid "Parental Controls"
msgstr "Starševski nadzor"

#. Don’t break UI compatibility if parental controls are disabled.
#: scarecrow-initial-setup/pages/password/gis-password-page.c:79
msgid "Set a Password"
msgstr "Nastavi geslo"

#: scarecrow-initial-setup/pages/password/gis-password-page.c:80
#: scarecrow-initial-setup/pages/password/gis-password-page.c:89
msgid "Be careful not to lose your password."
msgstr "Pazite, da ne izgubite gesla."

#. Translators: The placeholder is for the user’s full name.
#: scarecrow-initial-setup/pages/password/gis-password-page.c:87
#, c-format
msgid "Set a Password for %s"
msgstr "Nastavi geslo za račun %s"

#: scarecrow-initial-setup/pages/password/gis-password-page.c:95
msgid "Set a Parent Password"
msgstr "Nastavi geslo za starševski nadzor"

#. Translators: The placeholder is the full name of the child user on the system.
#: scarecrow-initial-setup/pages/password/gis-password-page.c:97
#, c-format
msgid "This password will control access to the parental controls for %s."
msgstr "Geslo nadzoruje dostop do starševskega nadzora za račun %s."

#: scarecrow-initial-setup/pages/password/gis-password-page.c:228
msgid "This is a weak password."
msgstr "Vpisano geslo je šibko."

#: scarecrow-initial-setup/pages/password/gis-password-page.c:234
msgid "The passwords do not match."
msgstr "Gesli se ne skladata."

#: scarecrow-initial-setup/pages/password/gis-password-page.c:420
msgid "Password"
msgstr "Geslo"

#: scarecrow-initial-setup/pages/password/gis-password-page.ui:66
msgid "_Confirm"
msgstr "_Potrdi"

#: scarecrow-initial-setup/pages/password/pw-utils.c:81
msgctxt "Password hint"
msgid "The new password needs to be different from the old one."
msgstr "Novo geslo mora biti različno od starega."

#: scarecrow-initial-setup/pages/password/pw-utils.c:83
msgctxt "Password hint"
msgid ""
"This password is very similar to your last one. Try changing some letters "
"and numbers."
msgstr ""
"Vpisano geslo je zelo podobno prejšnjemu geslu. Poskusite dodatki kakšno "
"številko ali dodatno črko."

#: scarecrow-initial-setup/pages/password/pw-utils.c:85
#: scarecrow-initial-setup/pages/password/pw-utils.c:93
msgctxt "Password hint"
msgid ""
"This password is very similar to your last one. Try changing the password a "
"bit more."
msgstr ""
"Vpisano geslo je zelo podobno prejšnjemu geslu. Poskusite ga še malo "
"spremeniti."

#: scarecrow-initial-setup/pages/password/pw-utils.c:87
msgctxt "Password hint"
msgid ""
"This is a weak password. A password without your user name would be stronger."
msgstr ""
"Vpisano geslo je šibko. Geslo brez uporabniškega imena bi bilo močnejše."

#: scarecrow-initial-setup/pages/password/pw-utils.c:89
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid using your name in the password."
msgstr "Vpisano geslo je šibko. Ne uporabljajte imen in datumov v geslih."

#: scarecrow-initial-setup/pages/password/pw-utils.c:91
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to avoid some of the words included in the "
"password."
msgstr "Vpisano geslo je šibko. Izognite se nekaterim znanim besedam v geslu."

#: scarecrow-initial-setup/pages/password/pw-utils.c:95
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid common words."
msgstr "Vpisano geslo je šibko. Izogibajte se splošnim besedam."

#: scarecrow-initial-setup/pages/password/pw-utils.c:97
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid reordering existing words."
msgstr ""
"Vpisano geslo je šibko. Izogibajte se zgolj premetavanju obstoječih besed."

#: scarecrow-initial-setup/pages/password/pw-utils.c:99
msgctxt "Password hint"
msgid "This is a weak password. Try to use more numbers."
msgstr "Vpisano geslo je šibko. Dodajte več številk."

#: scarecrow-initial-setup/pages/password/pw-utils.c:101
msgctxt "Password hint"
msgid "This is a weak password. Try to use more uppercase letters."
msgstr "Vpisano geslo je šibko. Dodajte več velikih črk."

#: scarecrow-initial-setup/pages/password/pw-utils.c:103
msgctxt "Password hint"
msgid "This is a weak password. Try to use more lowercase letters."
msgstr "Vpisano geslo je šibko. Dodajte več malih črk."

#: scarecrow-initial-setup/pages/password/pw-utils.c:105
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to use more special characters, like "
"punctuation."
msgstr ""
"Vpisano geslo je šibko. Poskusite dodati več posebnih znakov, kot so na "
"primer ločila."

#: scarecrow-initial-setup/pages/password/pw-utils.c:107
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to use a mixture of letters, numbers and "
"punctuation."
msgstr "Vpisano geslo je šibko. Poskusite uporabiti črke, številke in ločila."

#: scarecrow-initial-setup/pages/password/pw-utils.c:109
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid repeating the same character."
msgstr "Vpisano geslo je šibko. Izogibajte se ponavljanju istega znaka."

#: scarecrow-initial-setup/pages/password/pw-utils.c:111
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to avoid repeating the same type of character: "
"you need to mix up letters, numbers and punctuation."
msgstr ""
"Vpisano geslo je šibko. Izogibajte se ponavljanju istih znakov; črke in "
"številke morajo biti čim bolj premešane."

#: scarecrow-initial-setup/pages/password/pw-utils.c:113
msgctxt "Password hint"
msgid "This is a weak password. Try to avoid sequences like 1234 or abcd."
msgstr ""
"Vpisano geslo je šibko. Izogibajte se logičnih zaporedjem, kot sta 1234 ali "
"abcd."

#: scarecrow-initial-setup/pages/password/pw-utils.c:115
msgctxt "Password hint"
msgid ""
"This is a weak password. Try to add more letters, numbers and punctuation."
msgstr ""
"Vpisano geslo je šibko. Poskusite dodati več črk, številke in druge znake."

#: scarecrow-initial-setup/pages/password/pw-utils.c:117
msgctxt "Password hint"
msgid "Mix uppercase and lowercase and try to use a number or two."
msgstr "Priporočljivo je uporabiti velike in male črke ter kakšno številko."

#: scarecrow-initial-setup/pages/password/pw-utils.c:119
msgctxt "Password hint"
msgid ""
"Adding more letters, numbers and punctuation will make the password stronger."
msgstr "Dodajanje črk, številk in ločil poveča moč gesla."

#. Translators: the parameter here is the name of a distribution,
#. * like "Fedora" or "Ubuntu". It falls back to "GNOME" if we can't
#. * detect any distribution.
#.
#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.c:68
#, c-format
msgid ""
"Sending reports of technical problems helps us to improve %s. Reports are "
"sent anonymously and are scrubbed of personal data."
msgstr ""
"Pošiljanje poročil o tehničnih težavah lahko pripomore k izboljšanju "
"delovanja %s. Poročila so poslana brezimno in brez zasebnih podatkov."

#. Translators: the parameter here is the name of a distribution,
#. * like "Fedora" or "Ubuntu". It falls back to "GNOME" if we can't
#. * detect any distribution.
#.
#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.c:78
#, c-format
msgid "Problem data will be collected by %s:"
msgstr "Problematične podatke bo zbiral %s:"

#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.c:79
#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.c:135
#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.c:210
msgid "Privacy Policy"
msgstr "Pravila zasebnosti"

#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.c:135
msgid "Uses Mozilla Location Service:"
msgstr "Uporablja storitev določanja mesta Mozilla:"

#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.c:246
#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.ui:16
msgid "Privacy"
msgstr "Zasebnost"

#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.ui:31
msgid "Location Services"
msgstr "Storitve določanja položaja"

#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.ui:52
msgid ""
"Allows applications to determine your geographical location. An indication "
"is shown when location services are in use."
msgstr ""
"Omogoča programom določiti geografski položaj. Ko so storitve v rabi, je "
"prikazan poseben kazalnik."

#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.ui:74
msgid "Automatic Problem Reporting"
msgstr "Samodejna poročila o težavah"

#: scarecrow-initial-setup/pages/privacy/gis-privacy-page.ui:110
msgid ""
"Privacy controls can be changed at any time from the Settings application."
msgstr "Določila zasebnosti je mogoče prilagajati med nastavitvami."

#. Translators: the parameter here is the name of a distribution,
#. * like "Fedora" or "Ubuntu". It falls back to "GNOME 3" if we can't
#. * detect any distribution.
#: scarecrow-initial-setup/pages/summary/gis-summary-page.c:233
#, c-format
msgid "_Start Using %s"
msgstr "_Začni uporabljati %s"

#. Translators: the parameter here is the name of a distribution,
#. * like "Fedora" or "Ubuntu". It falls back to "GNOME 3" if we can't
#. * detect any distribution.
#: scarecrow-initial-setup/pages/summary/gis-summary-page.c:240
#, c-format
msgid "%s is ready to be used. We hope that you love it!"
msgstr ""
"Račun %s je pripravljen za uporabo. Upamo, da vam bo delo z njim v veselje."

#: scarecrow-initial-setup/pages/summary/gis-summary-page.c:264
msgid "Setup Complete"
msgstr "Nastavitev je končana."

#: scarecrow-initial-setup/pages/summary/gis-summary-page.ui:70
msgid "All done!"
msgstr "Končano!"

#. Translators: "city, country"
#: scarecrow-initial-setup/pages/timezone/gis-timezone-page.c:261
#, c-format
msgctxt "timezone loc"
msgid "%s, %s"
msgstr "%s, %s"

#. Translators: UTC here means the Coordinated Universal Time.
#. * %:::z will be replaced by the offset from UTC e.g. UTC+02
#.
#: scarecrow-initial-setup/pages/timezone/gis-timezone-page.c:298
msgid "UTC%:::z"
msgstr "UTC%:::z"

#. Translators: This is the time format used in 12-hour mode.
#: scarecrow-initial-setup/pages/timezone/gis-timezone-page.c:302
msgid "%l:%M %p"
msgstr "%l:%M %p"

#. Translators: This is the time format used in 24-hour mode.
#: scarecrow-initial-setup/pages/timezone/gis-timezone-page.c:305
msgid "%R"
msgstr "%R"

#. Translators: "timezone (utc shift)"
#: scarecrow-initial-setup/pages/timezone/gis-timezone-page.c:308
#, c-format
msgctxt "timezone map"
msgid "%s (%s)"
msgstr "%s (%s)"

#: scarecrow-initial-setup/pages/timezone/gis-timezone-page.c:473
#: scarecrow-initial-setup/pages/timezone/gis-timezone-page.ui:17
msgid "Time Zone"
msgstr "Časovni pas"

#: scarecrow-initial-setup/pages/timezone/gis-timezone-page.ui:18
msgid ""
"The time zone will be set automatically if your location can be found. You "
"can also search for a city to set it yourself."
msgstr ""
"Časovno območje je nastavljeno samodejno, če je vaše trenutno mesto mogoče "
"določiti. Mesto je mogoče izbrati tudi ročno."

#: scarecrow-initial-setup/pages/timezone/gis-timezone-page.ui:56
msgid "Please search for a nearby city"
msgstr "Poiščite bližnje mesto"

#. Translators: This is meant to be a warm, engaging welcome message,
#. * like greeting somebody at the door. If the exclamation mark is not
#. * suitable for this in your language you may replace it. The space
#. * before the exclamation mark in this string is a typographical thin
#. * space (U200a) to improve the spacing in the title, which you can
#. * keep or remove. The %s is getting replaced with the name and version
#. * of the OS, e.g. "GNOME 3.38"
#.
#: scarecrow-initial-setup/pages/welcome/gis-welcome-page.c:209
#, c-format
msgid "Welcome to %s !"
msgstr "Dobrodošli v namestitvi %s!"

#: scarecrow-initial-setup/pages/welcome/gis-welcome-page.ui:5
msgid "Setup"
msgstr "Nastavitev"

#: scarecrow-initial-setup/pages/welcome/gis-welcome-page.ui:43
msgid ""
"Setup will guide you through making an account and enabling some features. "
"We’ll have you up and running in no time."
msgstr ""
"Čarovnik omogoča vodenje prek postopka ustvarjanja računa in omogočanja "
"zmožnosti. Postopek je kratek in enostaven."

