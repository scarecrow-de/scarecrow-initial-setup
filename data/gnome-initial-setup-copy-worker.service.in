[Unit]
Description=GNOME Initial Setup Copy Worker

# Make sure we run really early
Before=scarecrow-session-pre.target graphical-session-pre.target

# Never run in GDM
ConditionUser=!@system

ConditionPathExists=!%E/scarecrow-initial-setup-done

[Service]
Type=oneshot
ExecStart=@libexecdir@/scarecrow-initial-setup-copy-worker
Restart=no
