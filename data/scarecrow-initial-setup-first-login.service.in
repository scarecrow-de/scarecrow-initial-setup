[Unit]
Description=Scarecrow Initial Setup

BindsTo=scarecrow-session.target
After=scarecrow-session.target

# Together with Type=oneshot, make sure the welcome tour starts after setup
Before=scarecrow-welcome-tour.service

# Never run in GDM
Conflicts=scarecrow-session@scarecrow-login.target

Conflicts=scarecrow-session@scarecrow-initial-setup.target
ConditionPathExists=!%E/scarecrow-initial-setup-done

[Service]
Type=oneshot
ExecStart=@libexecdir@/scarecrow-initial-setup --existing-user
Restart=no
