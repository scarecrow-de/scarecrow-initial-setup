[Desktop Entry]
Name=Scarecrow Initial Setup Copy Worker
Type=Application
Exec=@LIBEXECDIR@/scarecrow-initial-setup-copy-worker
OnlyShowIn=Scarecrow;
NoDisplay=true
X-Scarecrow-AutoRestart=false
X-Scarecrow-Autostart-Phase=EarlyInitialization
AutostartCondition=unless-exists scarecrow-initial-setup-done
X-Scarecrow-HiddenUnderSystemd=@systemd_hidden@
